---
/**
 * Footer.astro - Pie de pagina con 4 columnas
 * Contacto, Horario, Links legales, Redes sociales
 */
import { clinic, getPhoneLink, getEmailLink, getEmergencyPhoneLink } from "../config/clinic";

const currentYear = new Date().getFullYear();
const primaryColor = clinic.design.colors.primary;
---

<footer class="bg-gray-900 text-white pt-12 pb-6">
  <div class="container mx-auto px-4 sm:px-6 max-w-6xl">

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-10">

      <!-- Columna 1: Sobre nosotros -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4 group transition-transform hover:scale-[1.02]">
          <img
            src="/images/logo.jpg"
            alt={`Logo ${clinic.identity.name}`}
            class="h-12 w-12 object-cover rounded-lg bg-white p-1"
            loading="lazy"
          />
          <span class="text-lg font-bold text-white">
            Clinica Veterinaria <span style={`color: ${clinic.design.colors.secondary};`}>2000</span>
          </span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          {clinic.identity.tagline}. Manolo y Lucia cuidan de tu mascota como si fuera suya.
        </p>

        <!-- Redes sociales -->
        {clinic.contact.social.facebook && (
          <div class="flex gap-3 mt-4">
            <a
              href={clinic.contact.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Columna 2: Contacto -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">
          Contacto
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href={getPhoneLink()}
              class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors text-sm"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span><strong>Citas:</strong> {clinic.contact.phones.primary}</span>
            </a>
          </li>
          <li>
            <a
              href={getEmergencyPhoneLink()}
              class="flex items-center gap-3 text-red-400 hover:text-red-300 transition-colors text-sm"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
              <span><strong>Urgencias:</strong> {clinic.contact.phones.emergency}</span>
            </a>
          </li>
          <li>
            <a
              href={getEmailLink()}
              class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors text-sm"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {clinic.contact.email}
            </a>
          </li>
          <li class="flex items-start gap-3 text-gray-300 text-sm">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>
              {clinic.location.address}<br/>
              {clinic.location.postalCode} {clinic.location.city}
            </span>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Horario -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">
          Horario
        </h3>
        <ul class="space-y-2 text-sm">
          <li class="flex justify-between text-gray-300">
            <span>Lunes - Viernes</span>
            <span class="text-gray-400">{clinic.schedule.weekdays}</span>
          </li>
          <li class="flex justify-between text-gray-300">
            <span>Sabados</span>
            <span class="text-gray-400">{clinic.schedule.saturday}</span>
          </li>
          <li class="flex justify-between text-gray-300">
            <span>Domingos</span>
            <span class="text-gray-400">{clinic.schedule.sunday}</span>
          </li>
          {clinic.schedule.notes && (
            <li class="pt-2 mt-2 border-t border-gray-800">
              <span class="text-xs font-medium text-red-400">
                {clinic.schedule.notes}
              </span>
            </li>
          )}
        </ul>
      </div>

      <!-- Columna 4: Como llegar -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">
          Encuentranos
        </h3>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(clinic.location.address + ', ' + clinic.location.city)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full py-3 px-4 text-center text-white font-bold rounded-lg transition-all hover:opacity-90"
          style={`background-color: ${primaryColor}`}
        >
          Como llegar
        </a>

        <a
          href={getPhoneLink()}
          class="mt-3 flex items-center justify-center gap-2 w-full py-3 px-4 bg-gray-800 hover:bg-gray-700 text-white font-bold rounded-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Llamar ahora
        </a>
      </div>
    </div>

    <!-- Linea divisoria -->
    <div class="border-t border-gray-800 pt-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">

        <!-- Copyright -->
        <p>
          &copy; {currentYear} {clinic.identity.name}. Todos los derechos reservados.
        </p>

        <!-- Enlaces legales -->
        <nav class="flex flex-wrap justify-center gap-4 md:gap-6">
          <a href="/aviso-legal" class="hover:text-white transition-colors">
            Aviso Legal
          </a>
          <a href="/politica-privacidad" class="hover:text-white transition-colors">
            Privacidad
          </a>
          <a href="/politica-cookies" class="hover:text-white transition-colors">
            Cookies
          </a>
        </nav>

        <!-- Firma KyberSites -->
        <p class="text-gray-600 text-xs">
          Disenado con amor por
          <a
            href="https://sites.kybervet.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-white"
            style={`color: ${primaryColor}`}
          >
            KyberSites
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
