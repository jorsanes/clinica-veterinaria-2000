---
/**
 * Contact Component - Clinica Veterinaria 2000
 * Seccion de contacto con informacion y mapa de Google
 */
import { clinic, getPhoneLink, getEmergencyLink } from "../data/clinic";

const primaryColor = clinic.design.colors.primary;
const secondaryColor = clinic.design.colors.secondary;
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <!-- Contact Info -->
      <div class="contact-info">
        <h2 class="section-title">
          Ven a conocernos,<br />tu mascota te lo agradecera.
        </h2>

        <div class="contact-details">
          <!-- Address -->
          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Direccion:</strong>
              <p>
                {clinic.location.address}<br />
                {clinic.location.postalCode} {clinic.location.city}, {clinic.location.province}.
              </p>
            </div>
          </div>

          <!-- Phones -->
          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <div class="contact-text">
              <p>
                <strong>Citas (Fijo):</strong>{" "}
                <a href={getPhoneLink()} class="phone-link">{clinic.contact.phones.primary}</a>
              </p>
              <p>
                <strong>Urgencias (Movil):</strong>{" "}
                <a href={getEmergencyLink()} class="phone-link emergency">{clinic.contact.phones.emergency}</a>
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Email:</strong>{" "}
              <a href={`mailto:${clinic.contact.email}`} class="email-link">{clinic.contact.email}</a>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <a href={getPhoneLink()} class="cta-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar al Fijo ({clinic.contact.phones.primary})
        </a>
      </div>

      <!-- Google Maps -->
      <div class="map-container">
        <iframe
          src={clinic.location.googleMapsEmbed}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Ubicacion ${clinic.identity.name}`}
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ primaryColor, secondaryColor }}>
  .contact-section {
    background-color: var(--primaryColor);
    color: white;
    padding: 4rem 0;
  }

  .container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .contact-details {
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-size: 1.125rem;
  }

  .contact-item:last-child {
    margin-bottom: 0;
  }

  .contact-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    opacity: 0.9;
    margin-top: 2px;
  }

  .contact-text {
    line-height: 1.5;
  }

  .contact-text p {
    margin: 0;
  }

  .contact-text strong {
    font-weight: 600;
  }

  .phone-link,
  .email-link {
    color: white;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .phone-link:hover,
  .email-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .phone-link.emergency {
    color: var(--secondaryColor);
    font-weight: 600;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--primaryColor);
    background: white;
    border: 2px solid white;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .cta-button:hover {
    background: transparent;
    color: white;
    transform: translateY(-2px);
  }

  .cta-button:focus {
    outline: 3px solid white;
    outline-offset: 2px;
  }

  .map-container {
    height: 100%;
    min-height: 350px;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .map-container iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 350px;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 1.5rem;
    }

    .contact-item {
      font-size: 1rem;
    }

    .map-container {
      min-height: 300px;
    }
  }
</style>
