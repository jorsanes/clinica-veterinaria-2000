---
/**
 * About Component - Clinica Veterinaria 2000
 * Seccion sobre el equipo (Manolo y Lucia)
 * Con imagen de fondo, texto y check-list de valores
 */
import { clinic } from "../data/clinic";

const primaryColor = clinic.design.colors.primary;
const secondaryColor = clinic.design.colors.secondary;

const checklistItems = [
  "Trato 100% personalizado.",
  "Experiencia contrastada en perros, gatos y aves.",
  "Pasion real por lo que hacemos.",
];
---

<section id="equipo" class="about-section">
  <div class="about-overlay"></div>
  <div class="container">
    <div class="about-content">
      <h2 class="section-title">
        Profesionalidad, dedicacion y <br />mucho amor por los animales.
      </h2>

      <div class="about-text">
        <p>
          En Clinica Veterinaria 2000, no eres un numero mas.
        </p>
        <p>
          Somos <strong>{clinic.team.members.join(" y ")}</strong>, un equipo apasionado por la salud animal.
        </p>
        <p>
          Creemos en una veterinaria honesta, donde la prioridad es siempre el bienestar de Suka, Diego, Kaoba, Mokka... o como se llame tu companero de vida.
        </p>
        <p>
          Llevamos anos cuidando de las mascotas de {clinic.location.city} con un enfoque cercano y riguroso.
        </p>
      </div>

      <ul class="check-list">
        {checklistItems.map((item) => (
          <li class="check-item">
            <span class="check-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style define:vars={{ primaryColor, secondaryColor }}>
  .about-section {
    position: relative;
    padding: 6rem 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background-image: url('/assets/images/equipo.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: white;
  }

  .about-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  .container {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .about-content {
    max-width: 600px;
    background: rgba(220, 38, 38, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 2rem;
    border-radius: 1rem;
    border-left: 5px solid var(--secondaryColor);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: white;
    line-height: 1.3;
  }

  .about-text {
    margin-bottom: 1.5rem;
  }

  .about-text p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.5rem;
  }

  .about-text strong {
    color: white;
    font-weight: 600;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .check-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #4ade80;
  }

  @media (max-width: 768px) {
    .about-section {
      min-height: auto;
      padding: 4rem 0;
    }

    .container {
      justify-content: center;
    }

    .about-content {
      max-width: 100%;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .about-text p {
      font-size: 1rem;
    }

    .check-item {
      font-size: 1rem;
    }
  }
</style>
