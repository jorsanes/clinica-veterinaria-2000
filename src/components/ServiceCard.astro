---
/**
 * ServiceCard - Tarjeta individual de servicio
 * Muestra icono emoji, nombre y descripcion
 * Lee colores desde clinic.ts
 */
import { clinic } from "../config/clinic";

interface Props {
  name: string;
  description: string;
  emoji: string;
  href?: string;
}

const { name, description, emoji, href } = Astro.props;

// Colores de clinic.ts
const primaryColor = clinic.design.colors.primary;
const textColor = clinic.design.colors.text;
const textMutedColor = clinic.design.colors.textMuted;

// Si hay href, usamos <a>, sino <div>
const Tag = href ? 'a' : 'div';
---

<div
  class="service-card"
  style={`--card-primary: ${primaryColor};`}
>
  <!-- Emoji Icon -->
  <div class="service-icon">
    {emoji}
  </div>

  <!-- Content -->
  <h3 class="service-title" style={`color: ${primaryColor};`}>
    {name}
  </h3>
  <p class="service-description" style={`color: ${textMutedColor};`}>
    {description}
  </p>
</div>

<style>
  .service-card {
    background: white;
    padding: 2rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    transition: transform 0.3s ease;
    text-align: center;
  }

  .service-card:hover {
    transform: translateY(-5px);
  }

  .service-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .service-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .service-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
