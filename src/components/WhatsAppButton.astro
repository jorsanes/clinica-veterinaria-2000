---
/**
 * WhatsApp Button - Clinica Veterinaria 2000
 * Boton flotante de WhatsApp para contacto rapido
 */
import { clinic, getWhatsAppLink } from "../data/clinic";

// Solo mostrar si hay WhatsApp configurado
const hasWhatsApp = clinic.contact.whatsapp && clinic.contact.whatsapp.length > 5;
const whatsappUrl = getWhatsAppLink("Hola, me gustaria informacion sobre...");
---

{hasWhatsApp && whatsappUrl && (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-button"
    aria-label="Contactar por WhatsApp"
  >
    <div class="whatsapp-wrapper">
      <!-- Pulse Animation -->
      <span class="pulse-ring"></span>

      <!-- Button -->
      <div class="button-inner">
        <svg
          class="whatsapp-icon"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </div>
    </div>

    <!-- Tooltip (Desktop) -->
    <span class="tooltip">Necesitas ayuda?</span>
  </a>
)}

<style>
  .whatsapp-button {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    text-decoration: none;
  }

  .whatsapp-wrapper {
    position: relative;
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: #25D366;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    opacity: 0.25;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.25;
      transform: scale(1);
    }
    50% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .button-inner {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    background-color: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .whatsapp-button:hover .button-inner {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  }

  .whatsapp-icon {
    width: 1.75rem;
    height: 1.75rem;
    color: white;
  }

  .tooltip {
    display: none;
    position: absolute;
    right: 100%;
    margin-right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background-color: #1f2937;
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-left-color: #1f2937;
  }

  @media (min-width: 768px) {
    .button-inner {
      width: 4rem;
      height: 4rem;
    }

    .whatsapp-icon {
      width: 2rem;
      height: 2rem;
    }

    .tooltip {
      display: block;
    }

    .whatsapp-button:hover .tooltip {
      opacity: 1;
    }
  }

  /* Accessibility */
  .whatsapp-button:focus {
    outline: none;
  }

  .whatsapp-button:focus .button-inner {
    outline: 3px solid #25D366;
    outline-offset: 3px;
  }
</style>
