---
/**
 * Home Page - Clinica Veterinaria 2000
 * Landing page completa con todas las secciones
 * Single-page style basada en el diseno original
 */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import { clinic, getPhoneLink } from "../config/clinic";
---

<Layout>
  <!-- Hero Section -->
  <Hero />

  <!-- Trust Bar / Testimonials -->
  <TrustBar />

  <!-- About / Equipo Section -->
  <About />

  <!-- Services Section -->
  <Services />

  <!-- How It Works Section -->
  <HowItWorks />

  <!-- FAQ Section -->
  <FAQ />

  <!-- Contact Section -->
  <Contact />

  <!-- CTA Final -->
  <section
    class="py-16 md:py-20"
    style={`background-color: ${clinic.design.colors.primary};`}
  >
    <div class="container mx-auto px-4 md:px-6 max-w-4xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Tu mascota merece el mejor cuidado
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        En Clinica Veterinaria 2000 estamos listos para atenderte.<br />
        Llama ahora y agenda tu cita.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={getPhoneLink()}
          class="inline-flex items-center justify-center gap-2 bg-white font-semibold px-8 py-4 rounded-full hover:bg-white/90 transition-all shadow-lg"
          style={`color: ${clinic.design.colors.primary};`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Pide tu cita - {clinic.contact.phones.primary}
        </a>
        {clinic.contact.phones.emergency && (
          <a
            href={`tel:${clinic.contact.phones.emergencyLink}`}
            class="inline-flex items-center justify-center gap-2 bg-transparent text-white font-semibold px-8 py-4 rounded-full border-2 border-white/30 hover:bg-white/10 transition-all"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            Urgencias: {clinic.contact.phones.emergency}
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>
