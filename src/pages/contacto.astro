---
/**
 * CONTACTO PAGE - Clinica Veterinaria 2000
 * Pagina dedicada de contacto con informacion completa,
 * mapa de Google Maps y formulario de contacto
 */
import Layout from "../layouts/Layout.astro";
import { clinic, getPhoneLink } from "../config/clinic";

// Construir direccion completa
const fullAddress = `${clinic.location.address}, ${clinic.location.postalCode} ${clinic.location.city}`;
---

<Layout
  title="Contacto"
  description={`Contacta con ${clinic.identity.name}. Estamos en ${fullAddress}. Telefono: ${clinic.contact.phones.primary}`}
>
  <!-- Header -->
  <section class="py-16" style={`background-color: ${clinic.design.colors.surface};`}>
    <div class="container mx-auto px-4 md:px-6 max-w-6xl text-center">
      <h1 class="text-4xl md:text-5xl font-black mb-4" style={`color: ${clinic.design.colors.primary};`}>
        Contacto
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style={`color: ${clinic.design.colors.textMuted};`}>
        Ven a conocernos. Tu mascota te lo agradecera.
      </p>
    </div>
  </section>

  <!-- Contenido Principal -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-6 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12">

        <!-- Info de contacto -->
        <div>
          <h2 class="text-2xl font-bold mb-6">Informacion de contacto</h2>

          <div class="space-y-6">
            <!-- Direccion -->
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                style={`background-color: ${clinic.design.colors.primary}15;`}
              >
                <svg class="w-6 h-6" style={`color: ${clinic.design.colors.primary};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold">Direccion</h3>
                <p style={`color: ${clinic.design.colors.textMuted};`}>{fullAddress}</p>
                <a
                  href={clinic.location.googleMapsLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-sm hover:underline mt-1 inline-block"
                  style={`color: ${clinic.design.colors.primary};`}
                >
                  Ver en Google Maps
                </a>
              </div>
            </div>

            <!-- Telefono Principal -->
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                style={`background-color: ${clinic.design.colors.primary}15;`}
              >
                <svg class="w-6 h-6" style={`color: ${clinic.design.colors.primary};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold">Telefono (Citas)</h3>
                <a href={getPhoneLink()} class="hover:underline transition-colors" style={`color: ${clinic.design.colors.textMuted};`}>
                  {clinic.contact.phones.primary}
                </a>
              </div>
            </div>

            <!-- Telefono Urgencias (si existe) -->
            {clinic.contact.phones.emergency && (
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                  style={`background-color: ${clinic.design.colors.accent}15;`}
                >
                  <svg class="w-6 h-6" style={`color: ${clinic.design.colors.accent};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold">Urgencias</h3>
                  <a href={`tel:${clinic.contact.phones.emergencyLink}`} class="hover:underline transition-colors font-semibold" style={`color: ${clinic.design.colors.accent};`}>
                    {clinic.contact.phones.emergency}
                  </a>
                </div>
              </div>
            )}

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                style={`background-color: ${clinic.design.colors.primary}15;`}
              >
                <svg class="w-6 h-6" style={`color: ${clinic.design.colors.primary};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold">Email</h3>
                <a href={`mailto:${clinic.contact.email}`} class="hover:underline transition-colors" style={`color: ${clinic.design.colors.textMuted};`}>
                  {clinic.contact.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Horarios -->
          <div class="mt-10 p-6 rounded-2xl" style={`background-color: ${clinic.design.colors.surface};`}>
            <h3 class="font-bold mb-4">Horario de atencion</h3>
            <ul class="space-y-2" style={`color: ${clinic.design.colors.textMuted};`}>
              <li class="flex justify-between">
                <span>Lunes - Viernes</span>
                <span>{clinic.schedule.weekdays}</span>
              </li>
              <li class="flex justify-between">
                <span>Sabados</span>
                <span>{clinic.schedule.saturday}</span>
              </li>
              <li class="flex justify-between">
                <span>Domingos</span>
                <span>{clinic.schedule.sunday}</span>
              </li>
              {clinic.schedule.notes && (
                <li class="pt-2 mt-2 border-t border-gray-200">
                  <span class="font-medium" style={`color: ${clinic.design.colors.accent};`}>
                    {clinic.schedule.notes}
                  </span>
                </li>
              )}
            </ul>
          </div>

          <!-- Boton CTA -->
          <div class="mt-8">
            <a
              href={getPhoneLink()}
              class="inline-flex items-center justify-center gap-2 w-full font-semibold px-8 py-4 rounded-full transition-all shadow-lg text-white"
              style={`background-color: ${clinic.design.colors.primary};`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Llamar ahora ({clinic.contact.phones.primary})
            </a>
          </div>
        </div>

        <!-- Columna derecha: Mapa + Formulario -->
        <div class="space-y-8">
          <!-- Mapa -->
          <div class="rounded-3xl overflow-hidden shadow-xl h-[300px]">
            {clinic.location.googleMapsEmbed ? (
              <iframe
                src={clinic.location.googleMapsEmbed}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Ubicacion de ${clinic.identity.name}`}
              ></iframe>
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gray-100">
                <div class="text-center p-8">
                  <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <p class="text-gray-500">Mapa proximamente</p>
                  <a
                    href={clinic.location.googleMapsLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block mt-4 font-semibold hover:underline"
                    style={`color: ${clinic.design.colors.primary};`}
                  >
                    Ver en Google Maps
                  </a>
                </div>
              </div>
            )}
          </div>

          <!-- Formulario de Contacto -->
          <div class="p-8 rounded-3xl" style={`background-color: ${clinic.design.colors.surface};`}>
            <h3 class="text-xl font-bold mb-6">Envianos un mensaje</h3>
            <form id="contact-form" class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium mb-2">Nombre *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 transition-all"
                  style={`focus:ring-color: ${clinic.design.colors.primary}40; focus:border-color: ${clinic.design.colors.primary};`}
                  placeholder="Tu nombre"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium mb-2">Telefono *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 transition-all"
                  placeholder="Tu telefono"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 transition-all"
                  placeholder="Tu email (opcional)"
                />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium mb-2">Mensaje *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="4"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 transition-all resize-none"
                  placeholder="Cuentanos en que podemos ayudarte..."
                ></textarea>
              </div>
              <div class="flex items-start gap-2">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-1"
                />
                <label for="privacy" class="text-sm" style={`color: ${clinic.design.colors.textMuted};`}>
                  Acepto la <a href="/politica-privacidad" class="underline hover:no-underline" style={`color: ${clinic.design.colors.primary};`}>politica de privacidad</a>
                </label>
              </div>
              <button
                type="submit"
                class="w-full font-semibold px-8 py-4 rounded-full transition-all text-white hover:opacity-90"
                style={`background-color: ${clinic.design.colors.primary};`}
              >
                Enviar mensaje
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  input:focus, textarea:focus {
    --tw-ring-color: var(--color-primary);
    border-color: var(--color-primary);
  }
</style>
